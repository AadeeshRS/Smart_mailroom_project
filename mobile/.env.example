# Explicit modes: mock (local) or http (never falls back).
EXPO_PUBLIC_API_MODE=mock
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000/v1
# Optional convenience choices; use actual random account IDs printed by seed.
# Otherwise enter the server account ID on the HTTP login screen.
EXPO_PUBLIC_ASHA_ACCOUNT_ID=usr_REPLACE_WITH_SEEDED_ID
EXPO_PUBLIC_NEEL_ACCOUNT_ID=usr_REPLACE_WITH_SEEDED_ID
EXPO_PUBLIC_STAFF_ACCOUNT_ID=usr_REPLACE_WITH_SEEDED_ID
