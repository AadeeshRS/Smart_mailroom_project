generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  OPERATOR
  ADMIN
}

enum MemberType {
  STUDENT
  STAFF
}

enum CodePurpose {
  VERIFY
  RESET
}

enum ParcelStatus {
  IN_MAILROOM
  COLLECTED
  RETURNED
}

enum MatchSource {
  REQUEST
  CONTACT
  MANUAL
}

enum MatchFlag {
  AMBIGUOUS
  CONFLICT
}

enum RequestStatus {
  OPEN
  MATCHED
  CANCELLED
  EXPIRED
}

enum CollectionStatus {
  PENDING
  VERIFIED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum PushState {
  PENDING
  SENT
  FAILED
  /// The member had no device to push to.
  SKIPPED
}

model User {
  id              String      @id
  role            Role        @default(MEMBER)
  /// College email for members, any email for operators. Lowercase. Can't be changed.
  email           String      @unique
  /// Can't be changed by the member.
  name            String
  passwordHash    String?
  emailVerifiedAt DateTime?
  active          Boolean     @default(true)
  memberType      MemberType?
  /// Enrollment or staff ID.
  idNumber        String?     @unique
  /// Lowercase.
  personalEmail   String?
  /// E.164. Unique, so one person can't claim another's number.
  phone           String?     @unique
  altPhone        String?
  hostelId        String?
  hostel          Hostel?     @relation(fields: [hostelId], references: [id])
  roomNumber      String?
  createdAt       DateTime    @default(now())

  codes            EmailCode[]
  sessions         Session[]
  parcels          Parcel[]        @relation("Recipient")
  receivedParcels  Parcel[]        @relation("ReceivedBy")
  collectedParcels Parcel[]        @relation("CollectedBy")
  requests         ParcelRequest[]
  collections      Collection[]    @relation("Collector")
  handovers        Collection[]    @relation("Operator")
  notifications    Notification[]
  audits           AuditEvent[]

  @@index([altPhone])
  @@index([personalEmail])
}

model Hostel {
  id     String  @id
  name   String  @unique
  active Boolean @default(true)
  users  User[]
}

model EmailCode {
  id         String      @id
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    CodePurpose
  codeDigest String
  attempts   Int         @default(0)
  createdAt  DateTime    @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  @@index([userId, purpose])
  @@index([expiresAt])
}

model Session {
  id          String    @id
  tokenDigest String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  devices     Device[]

  @@index([userId])
  @@index([expiresAt])
}

/// An Expo push token, tied to the session that registered it: a revoked session gets no pushes, and deleting the
/// session deletes the token.
model Device {
  token     String   @id
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  platform  String
  createdAt DateTime @default(now())

  @@index([sessionId])
}

model Parcel {
  /// Client-generated UUID, so retrying an intake can't create a duplicate.
  id             String       @id
  /// Normalised: trimmed, uppercase, spaces removed.
  awb            String?
  orderId        String?
  carrier        String?
  labelName      String?
  /// E.164 if parseable, otherwise null (masked numbers).
  labelPhone     String?
  labelEmail     String?
  labelHostel    String?
  labelRoom      String?
  shelf          String
  note           String?
  status         ParcelStatus @default(IN_MAILROOM)
  recipientId    String?
  recipient      User?        @relation("Recipient", fields: [recipientId], references: [id])
  matchSource    MatchSource?
  matchFlag      MatchFlag?
  receivedAt     DateTime     @default(now())
  receivedById   String
  receivedBy     User         @relation("ReceivedBy", fields: [receivedById], references: [id])
  collectedAt    DateTime?
  collectedById  String?
  collectedBy    User?        @relation("CollectedBy", fields: [collectedById], references: [id])
  lastRemindedAt DateTime?

  requests      ParcelRequest[]
  notifications Notification[]
  audits        AuditEvent[]

  @@index([awb])
  @@index([orderId])
  @@index([labelPhone])
  @@index([labelEmail])
  @@index([recipientId, status])
  @@index([status, receivedAt])
  @@index([receivedAt])
  @@index([collectedAt])
}

model ParcelRequest {
  id          String        @id
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  awb         String
  orderId     String?
  carrier     String?
  /// Plain text: the operator reads it out. Cleared on match, cancellation or expiry.
  deliveryOtp String?
  note        String?
  status      RequestStatus @default(OPEN)
  parcelId    String?
  parcel      Parcel?       @relation(fields: [parcelId], references: [id])
  createdAt   DateTime      @default(now())
  expiresAt   DateTime

  @@index([userId, status])
  @@index([orderId])
}

/// One Collect now code; it covers all the member's parcels waiting in the mailroom.
model Collection {
  id          String           @id
  userId      String
  user        User             @relation("Collector", fields: [userId], references: [id])
  otpDigest   String
  attempts    Int              @default(0)
  status      CollectionStatus @default(PENDING)
  requestedAt DateTime         @default(now())
  expiresAt   DateTime
  completedAt DateTime?
  operatorId  String?
  operator    User?            @relation("Operator", fields: [operatorId], references: [id])

  @@index([status, requestedAt])
}

model Notification {
  id           String    @id
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  parcelId     String?
  parcel       Parcel?   @relation(fields: [parcelId], references: [id])
  type         String
  title        String
  body         String
  createdAt    DateTime  @default(now())
  readAt       DateTime?
  pushState    PushState @default(PENDING)
  pushAttempts Int       @default(0)
  /// The next push try waits until then (backoff after a failed try).
  pushAfter    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([pushState])
}

/// Append-only: a trigger rejects UPDATE and DELETE, with no bypass.
model AuditEvent {
  id       String   @id
  actorId  String
  actor    User     @relation(fields: [actorId], references: [id])
  parcelId String?
  parcel   Parcel?  @relation(fields: [parcelId], references: [id])
  action   String
  detail   String
  at       DateTime @default(now())

  @@index([parcelId, at])
}

model RateWindow {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}
