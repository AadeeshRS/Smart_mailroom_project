# Dedicated project database only; never use an unrelated database.
DATABASE_URL=postgresql://mailroom:CHANGE_ME@127.0.0.1:5432/smart_mailroom_dev
NODE_ENV=development
# Generate at least 32 random bytes; preserve across server restarts.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_PEPPER=CHANGE_ME_RANDOM_SECRET
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Comma-separated college email domains members may register with.
ALLOWED_EMAIL_DOMAINS=college.example
# Password for the dev fixture accounts created by `npm run seed` (development/test only).
SEED_PASSWORD=CHANGE_ME_DEV_PASSWORD
# Email: without RESEND_API_KEY, codes are printed to the console (development/test only).
# Production refuses to start without RESEND_API_KEY, MAIL_FROM and ALLOWED_EMAIL_DOMAINS.
RESEND_API_KEY=
MAIL_FROM=
# Behind a proxy (Render/Railway): 1, so rate limits see the client IP.
TRUST_PROXY=
# Per-IP limits per 15 minutes (every attempt counts, successful or not). Loose by default because a whole
# campus can share one public IP; per-email limits are fixed and strict (10 logins, 5 code emails).
RATE_LOGIN_PER_IP=300
RATE_CODES_PER_IP=150
RATE_CODE_CHECKS_PER_IP=300
