{
  "name": "smart-mailroom-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "start": "node --env-file-if-exists=.env dist/api/src/server.js",
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "seed": "node --env-file-if-exists=.env --import tsx src/seed.ts",
    "test": "node --env-file-if-exists=.env.test --import tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.7",
    "pg": "8.16.3",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "prisma": "7.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
